{
  "mcpServers": {
    "barmous": {
      "command": "node",
      "args": ["./mcp/server.mjs"],
      "cwd": ".",
      "env_vars": [
        "BARMOUS_API_URL",
        "BARMOUS_AGENT_TOKEN",
        "BARMOUS_PROFILE",
        "BARMOUS_CONFIG_DIR"
      ],
      "tool_timeout_sec": 45
    }
  }
}
